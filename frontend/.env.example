# Optional. Copy to .env.local (never committed).
# By default the app talks to port 8000 on the same host it was opened from, so on the
# venue Wi-Fi you normally need nothing here.
# VITE_API_URL=http://10.80.79.72:8000

# The owner key is NOT set here on purpose: anything in VITE_* ends up in the page's
