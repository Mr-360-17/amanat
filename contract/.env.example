# Copy to .env and fill in. NEVER commit .env.
# Throwaway testnet dev wallets only.

# mst = MST Testnet (real demo), local = `npm run node:local` on this laptop
NETWORK=mst
LOCAL_RPC_URL=http://127.0.0.1:8545

RPC_URL=https://testnetrpc.mstblockchain.com
CHAIN_ID=91562037
EXPLORER_URL=https://testnet.mstscan.com

# Filled automatically by scripts/generate-wallets.ts (only if empty)
OWNER_PRIVATE_KEY=
KEEPER_PRIVATE_KEY=
CONTACT1_PRIVATE_KEY=
CONTACT2_PRIVATE_KEY=
CONTACT3_PRIVATE_KEY=

# Comma-separated addresses, no gas needed
BENEFICIARY_ADDRESSES=

# Filled automatically by scripts/deploy.ts
CONTRACT_ADDRESS=
DEPLOY_BLOCK=

# Demo timers (seconds). DEMO_MODE=false uses 30d / 7d / 2d.
DEMO_MODE=true
DEMO_CHECKIN_SECONDS=30
DEMO_GRACE_SECONDS=30
DEMO_RELEASE_DELAY_SECONDS=15

# Keeper + API
CHECK_INTERVAL_SECONDS=5
API_PORT=4000
# Shared secret for POST /vault/hash (teammate's backend sends it as x-api-key)
BACKEND_API_KEY=
VAULT_HASH=

# Adapter for the Amanat team backend (set AMANAT_KEEPER_URL=http://<this-laptop>:8100 there).
# The backend sends no auth header, so only localhost is allowed unless you list its IP.
ADAPTER_PORT=8100
ADAPTER_HOST=127.0.0.1
# e.g. ADAPTER_HOST=0.0.0.0 and ADAPTER_ALLOWED_IPS=10.80.79.12 if the backend is on another laptop
ADAPTER_ALLOWED_IPS=
