# Copy to backend/.env and fill in. Never commit .env.

# Which extractor to use: auto | claude | gemini | ollama | rules
# auto = Claude if ANTHROPIC_API_KEY is set, else Gemini if GEMINI_API_KEY is set, else rules.
AMANAT_LLM=auto

ANTHROPIC_API_KEY=
AMANAT_CLAUDE_MODEL=claude-opus-5
AMANAT_CLAUDE_EFFORT=low

GEMINI_API_KEY=
# Backup keys (e.g. teammates' Google accounts). Used when a key is rate-limited (HTTP 429).
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
AMANAT_GEMINI_MODEL=gemini-3.8-flash
# Backups tried in order if the main model is busy (HTTP 503/429) or retired (404)
AMANAT_GEMINI_FALLBACKS=gemini-3.7-flash,gemini-3.5-flash,gemini-flash-latest

# Max seconds per document before falling back to the rule-based extractor
AMANAT_LLM_TIME_BUDGET_S=45

# Trusted Circle: flag contacts silent for this many days; frontend page invite links open
AMANAT_REACHABILITY_DAYS=180
AMANAT_INVITE_BASE_URL=http://localhost:5173/circle

# Pratham's keeper agent, e.g. http://localhost:8100 . Empty = mock status/txlog.
AMANAT_KEEPER_URL=

# Reuse saved extraction results for files seen before (keep on for the demo).
AMANAT_USE_CACHE=1

# Secret the frontend sends as the X-Amanat-Key header. Empty = generated into data/owner.key
# (run_lan.ps1 prints it). Keeps other people on the venue Wi-Fi out of the API.
AMANAT_OWNER_KEY=

# 64 hex chars. Empty = a key is generated into backend/data/vault.key
AMANAT_VAULT_KEY=
